{
  "name": "@qwqbig/dsh-archive-delete",
  "version": "0.1.4",
  "description": "Recoverable archived-session cleanup for DeepSeek Harness · DSH 归档会话回收站",
  "type": "module",
  "license": "Apache-2.0",
  "author": "QwQBiG",
  "repository": { "type": "git", "url": "git+https://github.com/QwQBiG/dsh-archive-delete.git" },
  "main": "./lib/index.js",
  "bin": { "dsh-archive-delete-doctor": "./lib/doctor.js" },
  "exports": { ".": "./lib/index.js", "./client": "./lib/client.js", "./package.json": "./package.json" },
  "files": ["lib", "docs", "cordis.patch.yml", "README.md", "README.zh-CN.md", "CONTRIBUTING.md", "CONTRIBUTING.zh-CN.md", "CHANGELOG.md", "CHANGELOG.zh-CN.md", "LICENSE"],
  "engines": { "node": ">=24", "dsh": "0.2.1-rc.3" },
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && node scripts/build.mjs",
    "test": "node --import tsx --test test/*.test.ts test/*.test.tsx",
    "test:integration": "node --import tsx --test test/integration/*.test.ts",
    "check:docs": "node scripts/check-docs.mjs",
    "check:package": "node scripts/check-package.mjs",
    "verify": "pnpm build && pnpm test && pnpm test:integration && pnpm check:docs && pnpm check:package",
    "prepack": "pnpm build"
  },
  "dsh": { "manifestVersion": 1, "bundle": { "patch": "./cordis.patch.yml" }, "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-workspace", "@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-ui-renderer", "@deepseek-ai/dsh-api-workspace-controller"] } },
  "peerDependencies": { "@deepseek-ai/cordis": "4.0.5", "@deepseek-ai/dsh-app-boot": "0.2.1-rc.3", "@deepseek-ai/dsh-home-paths": "0.2.1-rc.3", "@deepseek-ai/node-addon-system": "0.1.2", "react": "^18.3.1" },
  "peerDependenciesMeta": { "@deepseek-ai/cordis": { "optional": true }, "@deepseek-ai/dsh-app-boot": { "optional": true }, "@deepseek-ai/dsh-home-paths": { "optional": true }, "@deepseek-ai/node-addon-system": { "optional": true }, "react": { "optional": true } },
  "devDependencies": { "@types/node": "^24.0.0", "@types/react": "^18.3.0", "@types/react-dom": "^18.3.0", "esbuild": "^0.25.0", "react": "18.3.1", "react-dom": "18.3.1", "tsx": "^4.20.0", "typescript": "~5.9.3" }
}
